<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The report is an SQL view over sale_order_line, so it does not inherit
         the record rules of sale.order.line: mirror them here. -->
    <record id="pending_delivery_report_comp_rule" model="ir.rule">
        <field name="name">Pending Delivery Report multi-company</field>
        <field name="model_id" ref="model_sunray_pending_delivery_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pending_delivery_report_personal_rule" model="ir.rule">
        <field name="name">Personal Pending Deliveries</field>
        <field name="model_id" ref="model_sunray_pending_delivery_report"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="pending_delivery_report_see_all" model="ir.rule">
        <field name="name">All Pending Deliveries</field>
        <field name="model_id" ref="model_sunray_pending_delivery_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
