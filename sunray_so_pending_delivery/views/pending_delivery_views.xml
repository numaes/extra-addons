<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Search View -->
        <record id="view_pending_delivery_report_search" model="ir.ui.view">
            <field name="name">sunray.pending.delivery.report.search</field>
            <field name="model">sunray.pending.delivery.report</field>
            <field name="arch" type="xml">
                <search string="Pending Delivery Analysis">
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <filter string="My Sales" name="my_sales" domain="[('user_id', '=', uid)]"/>
                    <group expand="1" string="Group By">
                        <filter string="Sale Order" name="group_by_order_id" context="{'group_by':'order_id'}"/>
                        <filter string="Customer" name="group_by_partner_id" context="{'group_by':'partner_id'}"/>
                        <filter string="Salesperson" name="group_by_user_id" context="{'group_by':'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_pending_delivery_report_tree" model="ir.ui.view">
            <field name="name">sunray.pending.delivery.report.tree</field>
            <field name="model">sunray.pending.delivery.report</field>
            <field name="arch" type="xml">
                <list string="Pending Delivery Orders" create="false" edit="false" delete="false">
                    <field name="order_id" optional="show"/>
                    <field name="partner_id" optional="show"/>
                    <field name="date_order" optional="show"/>
                    <field name="product_id" optional="show"/>
                    <field name="product_uom_qty" optional="show"/>
                    <field name="qty_delivered" optional="show"/>
                    <field name="qty_pending" optional="show"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="price_unit" optional="show"/>
                    <field name="price_subtotal" optional="show" sum="Total"/>
                    <field name="price_total" optional="show" sum="Total"/>
                    <field name="price_subtotal_pending" optional="show" sum="Total"/>
                    <field name="user_id" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_pending_delivery_report" model="ir.actions.act_window">
            <field name="name">Pending Delivery List</field>
            <field name="res_model">sunray.pending.delivery.report</field>
            <field name="view_mode">list,pivot</field> <!-- Added pivot for utility, though only tree requested -->
            <field name="view_id" ref="view_pending_delivery_report_tree"/>
            <field name="context">{'search_default_group_by_partner_id': 1}</field>
            <field name="search_view_id" ref="view_pending_delivery_report_search"/>
        </record>

        <!-- Menu -->
        <menuitem id="menu_pending_delivery_report"
                  name="Pending Delivery List"
                  parent="sale.sale_order_menu"
                  action="action_pending_delivery_report"
                  sequence="100"
                />

    </data>
</odoo>
