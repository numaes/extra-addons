<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_website_order_attachment" model="ir.ui.view">
        <field name="name">
            sale.order.view.form.inherit.website.order.attachment
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_line_attachments" icon="fa-paperclip">
                    <field
                        string="Attachments"
                        name="attachments_count"
                        widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
