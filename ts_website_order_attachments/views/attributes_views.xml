<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="product_attribute_form_view_inherit" model="ir.ui.view">
		<field name="name">product.attribute.form.views.inherit</field>
		<field name="model">product.attribute</field>
		<field name="inherit_id" ref="product.product_attribute_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='display_type']" position="after">
				<field name="is_file_upload_allowed" invisible="display_type != 'multi'"/>
			</xpath>
		</field>
	</record>
</odoo>
