<?xml version="1.0" encoding="utf-8" ?>

<templates xml:space="preserve">
    <!--
        [20.0] Rewritten for 20.0's mail.Chatter. The buttons follow core's current
        logic (canPostMessage, webChatterProps) with an icon and a label that hides on
        small screens; templates see nothing but `this.` under OWL 3.
    -->
    <t
        t-name="muk_web_theme.Chatter"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="replace">
            <button class="o-mail-Chatter-sendMessage btn text-nowrap" t-att-class="{
                'btn-primary': this.state.composerType !== 'note',
                'btn-secondary': this.state.composerType === 'note',
                'active': this.state.composerType === 'message',
            }" t-att-disabled="!this.state.thread.canPostMessage and this.thread().id" data-hotkey="m" t-on-click="() => this.toggleComposer('message')">
                <i class="oi me-sm-1" data-icon="mail"/>
                <span class="d-none d-sm-inline">Send message</span>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="replace">
            <button class="o-mail-Chatter-logNote btn text-nowrap" t-att-class="{
                'btn-primary active': this.state.composerType === 'note',
                'btn-secondary': this.state.composerType !== 'note',
            }" t-att-disabled="!this.state.thread.canPostMessage and this.thread().id" data-hotkey="shift+m" t-on-click="() => this.toggleComposer('note')">
                <i class="oi me-sm-1" data-icon="sticky_note_2"/>
                <span class="d-none d-sm-inline">Log note</span>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]/span" position="before">
            <i class="oi me-sm-1" data-icon="schedule"/>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]/span" position="attributes">
            <attribute name="class" add="d-none d-sm-inline" separator=" "/>
        </xpath>
        <xpath expr="//button[@t-on-click='this.popoutAttachment']" position="attributes">
            <attribute name="t-if">this.webChatterProps.isChatterAside and this.webChatterProps.hasAttachmentPreview and this.state.thread.attachmentsInWebClientView.length</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='this.onClickSearch']" position="after">
            <button
                class="btn btn-link px-1 o_muk_tracking_toggle"
                aria-label="Show/Hide Tracking"
                title="Show/Hide Tracking"
                t-on-click="() => this.onClickTrackingToggle()"
            >
                <i class="oi oi-fw" t-att-data-icon="this.trackingState.show ? 'visibility' : 'visibility_off'" role="img"/>
            </button>
        </xpath>
    </t>
</templates>
