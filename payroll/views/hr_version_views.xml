<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        [20.0] `hr.contract` is gone: the contract became `hr.version`, which lives in
        `hr` and has NO form view of its own. `hr.employee` delegates to it
        (`_inherits = {'hr.version': 'version_id'}`), so fields added to `hr.version`
        show on the employee form, and that is where these belong now. The group is
        `contract`, inside `payroll_group`, which the core labels "Contract Overview".
    -->
    <record id="hr_version_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="inside">
                <field name="schedule_pay" />
                <field name="struct_id" required="1" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="currency_id" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
